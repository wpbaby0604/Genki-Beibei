# ============================================================
#  Streamlit Secrets 範本 — 複製成 .streamlit/secrets.toml（本地）
#  或貼到 Streamlit Community Cloud → App → Settings → Secrets（雲端）
#  .streamlit/secrets.toml 已被 .gitignore，不會上傳。
# ============================================================

# --- 第一部分（雲端版原有）：Supabase + HMAC ---
SUPABASE_URL = "https://<你的專案>.supabase.co"   # 純根網址，不含 /rest/v1/
SUPABASE_KEY = "<anon public key>"
HMAC_SECRET  = "<32+ 字元隨機字串>"

# --- 模式二 陪伴貝貝：Gemini 金鑰（至少設一把；可多把備援）---
GEMINI_API_KEY_1 = "<你的 Gemini API Key>"
# GEMINI_API_KEY_2 = "<備援 1>"
# GEMINI_API_KEY_3 = "<備援 2>"
